.venv/
venv/
__pycache__/
*.py[cod]
.DS_Store

# Secrets never belong in git. A local token file (docker-compose's ${VAR}
# interpolation, ad-hoc scripts) must be untrackable by accident.
.env
.env.*
*.pem
*.key

# Local frontend tooling dependencies
node_modules/

# Generated replay output is not test source.
library/**/resources/run-artifacts/
library/**/resources/test-results/
library/**/resources/playwright-report/
library/**/resources/plan-result.json

# Ephemeral PDF binaries and runtime data must never enter Git history.
artifacts/
**/pdf-reports/

# Sandbox runtime data (sqlite db, artifacts) for local preview sessions.
.arena-artifacts/
